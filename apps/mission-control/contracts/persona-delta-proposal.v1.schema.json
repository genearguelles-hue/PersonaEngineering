{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persona.engineering/schemas/pe.persona-delta-proposal.v1.json",
  "title": "Persona Engineering Persona Delta Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "incident_id",
    "persona_id",
    "base_version",
    "proposed_version",
    "title",
    "hypothesis",
    "primitive_changes",
    "safety_constraints",
    "regression_objectives",
    "proposed_by",
    "status",
    "application_status",
    "review_history",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "pe.persona-delta-proposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^pdp-[a-f0-9]{12}$"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^bi-[a-f0-9]{12}$"
    },
    "persona_id": {
      "type": "string",
      "minLength": 1
    },
    "base_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "proposed_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "hypothesis": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4000
    },
    "primitive_changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primitive_id", "operation", "rationale"],
        "properties": {
          "primitive_id": {
            "type": "string"
          },
          "operation": {
            "enum": ["add", "replace", "remove"]
          },
          "current_value": {},
          "proposed_value": {},
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "safety_constraints": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string"
      }
    },
    "regression_objectives": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string"
      }
    },
    "proposed_by": {
      "type": "string"
    },
    "status": {
      "enum": ["pending_review", "approved", "rejected"]
    },
    "application_status": {
      "const": "not_applied"
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "reviewer_id", "notes", "reviewed_at"],
        "properties": {
          "decision": {
            "enum": ["approve", "reject"]
          },
          "reviewer_id": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
