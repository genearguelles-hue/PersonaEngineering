{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persona.engineering/schemas/resume/resume_candidate_profile_v1.schema.json",
  "title": "Canonical Resume Candidate Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "summary",
    "skills",
    "experience"
  ],
  "properties": {
    "schema_version": {
      "const": "pe.resume-candidate-profile.v1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string",
              "maxLength": 320
            },
            "phone": {
              "type": "string",
              "maxLength": 64
            },
            "location": {
              "type": "string",
              "maxLength": 200
            },
            "linkedin": {
              "type": "string",
              "maxLength": 500
            },
            "website": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 4000
    },
    "skills": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "employer",
          "role_title",
          "bullets"
        ],
        "properties": {
          "employer": {
            "type": "string",
            "maxLength": 300
          },
          "role_title": {
            "type": "string",
            "maxLength": 300
          },
          "dates": {
            "type": "string",
            "maxLength": 100
          },
          "bullets": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 2000
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "evidence_id": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 2000
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 1000
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "credential": {
                "type": "string",
                "maxLength": 500
              },
              "institution": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        ]
      }
    }
  }
}
