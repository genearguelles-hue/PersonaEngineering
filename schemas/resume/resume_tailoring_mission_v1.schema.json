{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persona.engineering/schemas/resume/resume_tailoring_mission_v1.schema.json",
  "title": "Resume Tailoring Mission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_type",
    "mode",
    "persona_binding",
    "candidate_source_refs",
    "target_job",
    "strategy",
    "output",
    "privacy",
    "governance"
  ],
  "properties": {
    "schema_version": {
      "const": "pe.resume_tailoring.mission.v1"
    },
    "mission_type": {
      "const": "resume_tailoring"
    },
    "mode": {
      "const": "governed"
    },
    "persona_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona_id",
        "minimum_version"
      ],
      "properties": {
        "persona_id": {
          "const": "pe.resume_tailoring_specialist"
        },
        "minimum_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "candidate_source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "target_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description_ref",
        "role_title"
      ],
      "properties": {
        "description_ref": {
          "$ref": "#/$defs/sourceRef"
        },
        "employer": {
          "type": "string"
        },
        "role_title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positioning",
        "must_include",
        "must_exclude",
        "tone"
      ],
      "properties": {
        "positioning": {
          "type": "string"
        },
        "must_include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tone": {
          "enum": [
            "executive",
            "technical",
            "hybrid",
            "concise"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "page_target",
        "application_ready_requires_user_approval"
      ],
      "properties": {
        "format": {
          "enum": [
            "docx",
            "pdf",
            "markdown"
          ]
        },
        "page_target": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "application_ready_requires_user_approval": {
          "const": true
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_payload_mode",
        "embedding_policy_id"
      ],
      "properties": {
        "ledger_payload_mode": {
          "enum": [
            "hash_and_reference",
            "encrypted_payload_reference"
          ]
        },
        "embedding_policy_id": {
          "const": "pe.resume_ideation_ingestion.v1"
        },
        "allow_employer_names_in_embeddings": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_pre_execution_authorization",
        "require_persona_assessment",
        "require_ledger_terminal_event",
        "require_zero_unsupported_claims"
      ],
      "properties": {
        "require_pre_execution_authorization": {
          "const": true
        },
        "require_persona_assessment": {
          "const": true
        },
        "require_ledger_terminal_event": {
          "const": true
        },
        "require_zero_unsupported_claims": {
          "const": true
        },
        "minimum_requirement_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.75
        }
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "uri",
        "content_hash",
        "authorization"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "canonical_profile",
            "resume",
            "cv",
            "project_record",
            "publication_record",
            "user_correction",
            "job_description",
            "prior_governed_artifact"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "authorization": {
          "const": "user_authorized"
        }
      }
    }
  }
}
