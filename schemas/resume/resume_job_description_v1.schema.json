{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persona.engineering/schemas/resume/resume_job_description_v1.schema.json",
  "title": "Canonical Resume Job Description",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "employer",
    "role_title",
    "description",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "pe.resume-job-description.v1"
    },
    "employer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "role_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 50000
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 3,
            "maxLength": 4000
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}
