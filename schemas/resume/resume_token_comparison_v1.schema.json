{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persona.engineering/schemas/resume-token-comparison-v1.schema.json",
  "title": "Persona Engineering Resume Token Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pair_id",
    "completed_at",
    "mission_class",
    "model",
    "reasoning_effort",
    "max_output_tokens",
    "execution_order",
    "source_hashes",
    "governed",
    "ungoverned",
    "evaluation",
    "evaluation_excluded_from_primary_totals",
    "token_delta",
    "token_change_percent",
    "interpretation",
    "governed_quality_score",
    "ungoverned_quality_score",
    "quality_delta",
    "governed_tokens_per_quality_point",
    "ungoverned_tokens_per_quality_point",
    "governed_repair_performed",
    "governed_application_ready",
    "claim_scope"
  ],
  "properties": {
    "schema_version": {"const": "pe.resume-token-comparison.v1"},
    "pair_id": {"type": "string", "minLength": 8, "maxLength": 200},
    "completed_at": {"type": "string", "format": "date-time"},
    "mission_class": {"const": "resume_tailoring"},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"type": "string", "minLength": 1},
    "max_output_tokens": {"type": "integer", "minimum": 256},
    "execution_order": {
      "type": "array",
      "prefixItems": [
        {"enum": ["governed", "ungoverned"]},
        {"enum": ["governed", "ungoverned"]}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_sha256", "job_sha256", "persona_sha256"],
      "properties": {
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "job_sha256": {"$ref": "#/$defs/sha256"},
        "persona_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "governed": {"$ref": "#/$defs/aggregate"},
    "ungoverned": {"$ref": "#/$defs/aggregate"},
    "evaluation": {"$ref": "#/$defs/aggregate"},
    "evaluation_excluded_from_primary_totals": {"const": true},
    "token_delta": {"type": "integer"},
    "token_change_percent": {"type": ["number", "null"]},
    "interpretation": {"type": "string"},
    "governed_quality_score": {"type": "number", "minimum": 0, "maximum": 1},
    "ungoverned_quality_score": {"type": "number", "minimum": 0, "maximum": 1},
    "quality_delta": {"type": "number", "minimum": -1, "maximum": 1},
    "governed_tokens_per_quality_point": {"type": ["number", "null"], "minimum": 0},
    "ungoverned_tokens_per_quality_point": {"type": ["number", "null"], "minimum": 0},
    "governed_repair_performed": {"type": "boolean"},
    "governed_application_ready": {"type": "boolean"},
    "claim_scope": {"const": "single matched pair; mechanism proof only"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "provider_reported",
        "call_count",
        "input_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "total_tokens",
        "latency_ms",
        "retry_count",
        "estimated_cost_usd",
        "tokens_by_category"
      ],
      "properties": {
        "arm": {"type": "string"},
        "provider_reported": {"const": true},
        "call_count": {"type": "integer", "minimum": 1},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "cache_write_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "integer", "minimum": 0},
        "retry_count": {"type": "integer", "minimum": 0},
        "estimated_cost_usd": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{8}$"},
        "tokens_by_category": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
